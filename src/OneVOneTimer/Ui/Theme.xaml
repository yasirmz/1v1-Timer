<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:OneVOneTimer.Ui">

    <!-- Tokens (Capture's theme: dark grey and beige) -->
    <SolidColorBrush x:Key="Bg" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="NavBg" Color="#161618"/>
    <SolidColorBrush x:Key="Surface" Color="#27272A"/>
    <SolidColorBrush x:Key="CardHover" Color="#303034"/>
    <SolidColorBrush x:Key="Stroke" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#4E4E53"/>
    <!-- The outline of a control (field, outlined button): 3:1 against the cards, so it reads as something to press or fill -->
    <SolidColorBrush x:Key="ControlStroke" Color="#7A7874"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#EEEAE3"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A8A49D"/>
    <SolidColorBrush x:Key="Accent" Color="#D9C4A1"/>
    <SolidColorBrush x:Key="AccentHover" Color="#DFCDAF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#35322F"/>
    <SolidColorBrush x:Key="OnAccent" Color="#18181A"/>
    <SolidColorBrush x:Key="Success" Color="#2ED47A"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB020"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <l:BoolToVisibilityConverter x:Key="Vis"/>

    <!-- Text -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,18"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- A card's own title, so a group of settings says what it is about -->
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Section}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Stroke}"/>
        <Setter Property="Margin" Value="0,14"/>
    </Style>

    <!-- A beige ring around a control reached with the keyboard (Tab); WPF draws it for keyboard focus only -->
    <Style x:Key="KeyFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="{StaticResource Bg}"
                            BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1.5">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnAccent}"/>
                            <Setter TargetName="Thumb" Property="Width" Value="14"/>
                            <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="18,10"/>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource ControlStroke}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16,9"/>
    </Style>

    <!-- Fields: the same inset look as the segmented buttons (dark fill, hairline border, 8 px corners). -->
    <SolidColorBrush x:Key="FieldFill" Color="#19191B"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1F1F21"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#19191B"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#4E4E53"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1F1F21"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#19191B"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#27272A"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#27272A"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#3A3A3E"/>
    <!-- Pop-ups (drop-down lists, menus, tooltips) on the cards' own grey, not Fluent's #2C2C2C. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#27272A"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#36363A"/>
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#27272A"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="FlyoutBackground" Color="#27272A"/>
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="ToolTipBackground" Color="#27272A"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A3A3E"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
    </Style>
    <!-- A hotkey box: a field like Capture's, beige-edged while it waits for a key or button -->
    <Style TargetType="l:BindingBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource FieldFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Border.CornerRadius" Value="8"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>
</ResourceDictionary>
