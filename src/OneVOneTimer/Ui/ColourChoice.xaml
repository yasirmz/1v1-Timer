<UserControl x:Class="OneVOneTimer.Ui.ColourChoice" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OneVOneTimer.Ui"
             FlowDirection="LeftToRight">
    <Grid>
        <!-- The colour and its code; a click opens Capture's colour picker under it -->
        <Button x:Name="Swatch" Style="{StaticResource Ghost}" Padding="8,6,12,6" Click="OnOpen" MinWidth="128"
                AutomationProperties.Name="{Binding Colour, ElementName=Root}">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource ControlStroke}" BorderThickness="1"
                        Background="{Binding Brush, ElementName=Root}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Colour, ElementName=Root}" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="6">
            <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <l:ColourPicker Colour="{Binding Colour, ElementName=Root, Mode=TwoWay}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
