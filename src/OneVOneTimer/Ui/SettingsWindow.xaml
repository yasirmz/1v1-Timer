<Window x:Class="OneVOneTimer.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OneVOneTimer.Ui"
        Width="660" Height="820" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The window's own buttons (Capture's) -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowClose" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B5101C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A switch row's label and the line under it -->
        <Style x:Key="RowText" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the logo, the name, and the window's buttons -->
        <Border Background="{StaticResource NavBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"/>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/1v1Timer;component/Ui/Assets/logo.png" Width="30" Height="30"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{l:T app}"/>
            <TextBlock Text="{l:T app}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
            <TextBlock Text="{l:T settings.title}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="{l:T window.minimize}"/>
            <Button Style="{StaticResource WindowClose}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="{l:T window.close}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,20,28,24" MaxWidth="760">

                <!-- Hotkeys: a keyboard/mouse box and a controller box per action -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T hotkeys.card}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:T hotkeys.keyboard}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,7,0"/>
                                <TextBlock Text="{l:T hotkeys.controller}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <l:BindingBox Grid.Column="1" BindingText="{Binding Key}" AutomationProperties.Name="{Binding Label}"/>
                                        <l:BindingBox Grid.Column="3" BindingText="{Binding Pad}" IsPad="True" AutomationProperties.Name="{Binding Label}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T hotkeys.tip}" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T hotkeys.padTip}"/>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T options.card}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="{l:T options.startOnChange}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T options.startOnChangeTip}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartTimerOnChange}" AutomationProperties.Name="{l:T options.startOnChange}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="{l:T options.transparent}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T options.transparentTip}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding TransparentBackground}" AutomationProperties.Name="{l:T options.transparent}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="{l:T options.clickthrough}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T options.clickthroughTip}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ClickThrough}" AutomationProperties.Name="{l:T options.clickthrough}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T options.startup}" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="{l:T options.startup}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T options.resizeTip}" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Colors: each one shows on the timer as it is picked -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T colors.card}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T colors.timer}"/>
                            <l:ColourChoice Grid.Column="1" Colour="{Binding TimerColor}" AutomationProperties.Name="{l:T colors.timer}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T colors.selected}"/>
                            <l:ColourChoice Grid.Column="1" Colour="{Binding SelectedColor}" AutomationProperties.Name="{l:T colors.selected}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="{l:T colors.last20}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T colors.last20Tip}"/>
                            </StackPanel>
                            <l:ColourChoice Grid.Column="1" Colour="{Binding Last20Color}" VerticalAlignment="Center" AutomationProperties.Name="{l:T colors.last20}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T colors.background}"/>
                            <l:ColourChoice Grid.Column="1" Colour="{Binding BackgroundColor}" AutomationProperties.Name="{l:T colors.background}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General: language, updates, reset, help -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T general.card}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T general.language}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Language}" AutomationProperties.Name="{l:T general.language}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <!-- One line: the label, Check now (it says how the look went), and the daily look's switch -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="{l:T general.checkUpdates}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T general.installedOnly}"
                                           Visibility="{Binding CanCheckUpdates, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Padding="11,6" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center"
                                    Command="{Binding CheckNowCommand}" AutomationProperties.Name="{Binding CheckNowText}"
                                    Visibility="{Binding CanCheckUpdates, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Margin="0,0,7,0" Foreground="{StaticResource Success}"
                                               Visibility="{Binding CheckNowOk, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{Binding CheckNowText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CheckNowFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdates}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{l:T general.checkUpdates}"/>
                        </Grid>
                        <!-- A newer version: one line with its Update button -->
                        <Border Margin="0,12,0,0" Padding="14,8,8,8" CornerRadius="10" Background="{DynamicResource AccentSoft}"
                                Visibility="{Binding UpdateOffered, Converter={StaticResource Vis}}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{Binding UpdateActionText}" Command="{Binding UpdateCommand}" Padding="14,6"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource Label}" Text="{l:T general.reset}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T general.resetTip}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="{Binding ResetText}" Command="{Binding ResetCommand}"
                                    Padding="12,7" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T general.community}" Margin="0,0,16,0"/>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Command="{Binding OpenHelpCommand}" Padding="12,7" VerticalAlignment="Center"
                                    AutomationProperties.Name="{l:T general.help}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:T general.help}" FontSize="13.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.7"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
